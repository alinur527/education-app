DB_USERNAME=education
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=education
DB_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/education
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional file storage; local is the default. Do not commit real S3 credentials.
APP_STORAGE_PROVIDER=local
